{
    "name": "penblog/engine",
    "description": "PenBlog Engine - self-hosted blog with self-built kernel, theme, plugin and notification systems",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "PenBlog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PenBlog\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "composer", "url": "https://repo.packagist.org" }
    ],
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
